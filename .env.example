# =============================================================================
# Talentick — متغیرهای محیطی برای docker-compose.prod.yml
# =============================================================================
# این فایل را در ریشه‌ی پروژه روی سرور production کپی کنید به `.env` و
# مقادیر واقعی را جایگزین <...> کنید. docker compose به‌صورت خودکار فایل
# `.env` کنار docker-compose.yml را می‌خواند.
#
# ⚠️ بدون این مقادیر، docker-compose.prod.yml اصلاً بالا نمی‌آید (خطای
# "required variable ... is missing a value") — این عمدی است.

POSTGRES_USER=talentick
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
POSTGRES_DB=talentick

MINIO_ROOT_USER=<CHANGE_ME_MINIO_USER>
MINIO_ROOT_PASSWORD=<CHANGE_ME_STRONG_MINIO_PASSWORD>

# با `python -c "import secrets; print(secrets.token_urlsafe(64))"` بسازید
SECRET_KEY=<CHANGE_ME_RANDOM_SECRET_KEY>

# دامنه(های) واقعی فرانت — با کاما جدا از هم، بدون فاصله‌ی اضافه
ALLOWED_ORIGINS=https://your-domain.com
