# A generic, single database configuration — نمونه (بدون secret واقعی)
#
# ⚠️ توجه: این فایل در ریشه‌ی مونوریپو ظاهراً یک نسخه‌ی تکراری/قدیمی از
# backend/alembic.ini است (احتمالاً حاصل اجرای اشتباهی `alembic init` در
# ریشه‌ی پروژه). فایل واقعی مورد استفاده‌ی Docker/CI همان backend/alembic.ini
# است. اگر این فایل در ریشه استفاده‌ی عملی ندارد، پیشنهاد می‌شود حذف شود.

[alembic]
script_location = %(here)s/migrations
prepend_sys_path = .
path_separator = os

sqlalchemy.url = postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

[post_write_hooks]

[loggers]
keys = root,sqlalchemy,alembic

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = WARNING
handlers = console
qualname =

[logger_sqlalchemy]
level = WARNING
handlers =
qualname = sqlalchemy.engine

[logger_alembic]
level = INFO
handlers =
qualname = alembic

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(levelname)-5.5s [%(name)s] %(message)s
datefmt = %H:%M:%S
