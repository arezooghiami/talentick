# =============================================================================
# Talentick Backend — نمونه‌ی متغیرهای محیطی (بدون secret واقعی)
# =============================================================================
# کپی کنید به backend/.env و مقادیر واقعی را جایگزین <...> کنید.
# در docker-compose.prod.yml این مقادیر مستقیماً از environment سیستم/`.env`
# ریشه‌ی پروژه خوانده می‌شوند (نه از این فایل) — این فایل فقط برای dev محلی
# (بدون Docker) یا docker-compose.yml (dev) استفاده می‌شود.

APP_NAME=Talentick
APP_ENV=development
DEBUG=true

# با `python -c "import secrets; print(secrets.token_urlsafe(64))"` بسازید
SECRET_KEY=<CHANGE_ME_RANDOM_SECRET_KEY>

# در dev معمولاً از سرویس db در docker-compose (postgresql+asyncpg://...@db:5432/...)
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@localhost:5432/talentick

# دامنه(های) مجاز فرانت — با کاما جدا کنید
ALLOWED_ORIGINS=http://localhost,http://localhost:80

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── MinIO (اختیاری — مقدار پیش‌فرض در app/config.py) ───────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=<MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
MINIO_BUCKET_NAME=talentick
MINIO_USE_SSL=false
